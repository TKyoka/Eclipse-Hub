--// Fly Logic
local function enableFly()
    local hrp = getHRP()
    if not hrp then return end
    local hum = getHum()
    if hum then hum.PlatformStand = true end

    flyBV = Instance.new("BodyVelocity")
    flyBV.Velocity = Vector3.zero
    flyBV.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    flyBV.Parent = hrp

    flyBG = Instance.new("BodyGyro")
    flyBG.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    flyBG.P = 1e4
    flyBG.D = 100
    flyBG.CFrame = hrp.CFrame
    flyBG.Parent = hrp

    flyConn = RunService.RenderStepped:Connect(function()
        if not flyEnabled then return end
        local hrp2 = getHRP()
        if not hrp2 then return end
        local cf = cam.CFrame
        local dir = Vector3.zero

        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += cf.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= cf.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += cf.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= cf.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then dir -= Vector3.new(0, 1, 0) end

        flyBV.Velocity = dir.Magnitude > 0 and dir.Unit * flySpeed or Vector3.zero
        flyBG.CFrame = CFrame.new(hrp2.Position, hrp2.Position + cf.LookVector)
    end)
    Window:Cleanup(flyConn)
end

disableFly = function()
    flyEnabled = false
    if flyConn then 
        flyConn:Disconnect() 
        flyConn = nil 
    end
    if flyBV and flyBV.Parent then flyBV:Destroy() end
    if flyBG and flyBG.Parent then flyBG:Destroy() end
    flyBV, flyBG = nil, nil
    local hum = getHum()
    if hum then hum.PlatformStand = false end
end

--// Webhook Tracking Variables & Settings
local farmStartTime = 0
local initialGold = 0
local initialGoldBlocks = 0
local webhookInterval = "Every Run"
local lastWebhookTime = 0
local savedWebhookURL = ""

local function sendWebhook(customTitle)
    local url = savedWebhookURL
    if not url or url == "" then return end

    local currentGold = pcall(function() return lp.Data.Gold.Value end) and lp.Data.Gold.Value or 0
    local currentGoldBlocks = pcall(function() return lp.Data.GoldBlock.Value end) and lp.Data.GoldBlock.Value or 0
    
    local goldGained = currentGold - initialGold
    local blocksGained = currentGoldBlocks - initialGoldBlocks
    
    local sessionSeconds = autoFarmEnabled and math.floor(tick() - farmStartTime) or 0
    local hours = math.floor(sessionSeconds / 3600)
    local minutes = math.floor((sessionSeconds % 3600) / 60)
    local seconds = sessionSeconds % 60
    local sessionTimeFormatted = string.format("%02d:%02d:%02d", hours, minutes, seconds)

    local data = {
        ["content"] = "",
        ["embeds"] = {{
            ["title"] = customTitle or "Eclipse Hub - Build a Boat",
            ["color"] = 3092790,
            ["fields"] = {
                {
                    ["name"] = "**Session Stats**",
                    ["value"] = "**Blocks**: " .. tostring(blocksGained) .. "\n**Currency**: " .. tostring(goldGained) .. "\n**Session Time**: " .. sessionTimeFormatted,
                    ["inline"] = false
                },
                {
                    ["name"] = "**Total Stats**",
                    ["value"] = "**Blocks**: " .. tostring(currentGoldBlocks) .. "\n**Currency**: " .. tostring(currentGold),
                    ["inline"] = false
                }
            },
            ["footer"] = {
                ["text"] = "Eclipse Hub • " .. os.date("%X")
            }
        }}
    }

    local body = HttpService:JSONEncode(data)
    local headers = {["Content-Type"] = "application/json"}

    pcall(function()
        local httpRequest = http_request or request or syn.request
        if httpRequest then
            httpRequest({Url = url, Method = "POST", Headers = headers, Body = body})
        end
    end)
end

-- Fixed Time-based interval loop runner (with Cleanup flag)
local webhookLoopRunning = true
Window:Cleanup(function()
    webhookLoopRunning = false
end)

task.spawn(function()
    while webhookLoopRunning do
        task.wait(10)
        if autoFarmEnabled and savedWebhookURL and savedWebhookURL ~= "" then
            local _elapsedSinceStart = tick() - farmStartTime
            local elapsedSinceLast = tick() - lastWebhookTime
            
            local intervalSeconds = 0
            local titleText = ""

            if webhookInterval == "Every 15 Mins" then
                intervalSeconds = 15 * 60
                titleText = "Eclipse Hub - 15 Min Update"
            elseif webhookInterval == "Every 30 Mins" then
                intervalSeconds = 30 * 60
                titleText = "Eclipse Hub - 30 Min Update"
            elseif webhookInterval == "Every Hour" then
                intervalSeconds = 60 * 60
                titleText = "Eclipse Hub - Hourly Update"
            end

            if intervalSeconds > 0 and elapsedSinceLast >= intervalSeconds then
                lastWebhookTime = tick()
                sendWebhook(titleText)
            end
        end
    end
end)

--// Auto Farm Logic
local function cleanupFarmPart()
    if newPart and newPart.Parent then
        newPart:Destroy()
        newPart = nil
    end
end
Window:Cleanup(cleanupFarmPart)

local function teleportAndFarm(iteration)
    if not autoFarmEnabled then return end
    local char = getChar() or lp.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart")

    if not silentFarmEnabled then
        if iteration == 1 then
            hrp.CFrame = CFrame.new(160.161, 29.596, 973.814)
        elseif iteration == 5 then
            TriggerChest.CFrame = CFrame.new(-51, 65, 984 + 4 * 770)
            task.delay(0.8, function() Workspace.ClaimRiverResultsGold:FireServer() end)
            hrp.CFrame = CFrame.new(-51, 65, 984 + (iteration - 1) * 770)
        else
            hrp.CFrame = CFrame.new(-51, 65, 984 + (iteration - 1) * 770)
        end
    else
        if iteration == 1 then
            hrp.CFrame = CFrame.new(160.161, 29.596, 973.814)
        elseif iteration == 5 then
            TriggerChest.CFrame = CFrame.new(70.024, 138.903, 1371.634 + 3 * 770)
            task.delay(0.8, function() Workspace.ClaimRiverResultsGold:FireServer() end)
            hrp.CFrame = CFrame.new(70.024, 138.903, 1371.634 + (iteration - 2) * 770)
        else
            hrp.CFrame = CFrame.new(70.024, 138.903, 1371.634 + (iteration - 2) * 770)
        end
    end

    if newPart then
        newPart.Position = hrp.Position - Vector3.new(0, 2, 0)
    end

    if iteration == 1 then
        task.wait(2.3)
    else
        repeat task.wait() until #tostring(lp.OtherData:FindFirstChild("Stage" .. (iteration - 1)).Value) > 2
    end

    if iteration ~= 4 then
        Workspace.ClaimRiverResultsGold:FireServer()
    end

    if iteration == 10 then
        local ambient = Lighting.OutdoorAmbient
        if ambient == Color3.fromRGB(200, 200, 200) or ambient == Color3.fromRGB(255, 255, 255) then
            task.wait(0.1)
            local c = getChar()
            if c and c:FindFirstChild("HumanoidRootPart") and c.HumanoidRootPart.Position.Z > 7529.09 then
                c:BreakJoints()
            end
        end
    end
end

local function startAutoFarm()
    if not autoFarmEnabled then return end
    local char = getChar() or lp.CharacterAdded:Wait()
    char:WaitForChild("HumanoidRootPart")
    cleanupFarmPart()

    newPart = Instance.new("Part")
    newPart.Size = Vector3.new(5, 1, 5)
    newPart.Transparency = 1
    newPart.CanCollide = true
    newPart.Anchored = true
    newPart.Parent = Workspace

    for i = 1, 10 do
        if not autoFarmEnabled then break end
        teleportAndFarm(i)
    end

    cleanupFarmPart()

    if autoFarmEnabled then
        runCount += 1
        EclipseUI:Notify({ Title = "Auto Farm", Content = "Run #" .. runCount .. " complete!", Duration = 2.5 })
        if webhookInterval == "Every Run" then
            sendWebhook("Eclipse Hub - Run #" .. runCount .. " Completed")
        end
    end
end

local function onCharacterRespawned()
    if autoFarmEnabled then
        local char = getChar() or lp.CharacterAdded:Wait()
        char:WaitForChild("HumanoidRootPart")
        startAutoFarm()
    end
end

