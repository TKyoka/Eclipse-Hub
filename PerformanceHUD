local function triggerRejoin()
    if not autoRejoinEnabled then return end
    print("Disconnection detected! Attempting to rejoin Anime Adventures lobby...")
    task.wait(1)
    
    while autoRejoinEnabled do
        pcall(function()
            TeleportService:Teleport(targetPlaceId, lp)
        end)
        task.wait(2)
    end
end

task.spawn(function()
    pcall(function()
        local robloxPromptGui = CoreGui:WaitForChild("RobloxPromptGui", 10)
        if not robloxPromptGui then return end
        
        local promptOverlay = robloxPromptGui:WaitForChild("promptOverlay", 10)
        if not promptOverlay then return end
        
        if promptOverlay:FindFirstChild("ErrorPrompt") then
            task.spawn(triggerRejoin)
        end
        
        track(promptOverlay.ChildAdded:Connect(function(child)
            if child.Name == "ErrorPrompt" then
                triggerRejoin()
            end
        end))
    end)
end)

