local dragging, dragStart, startPos

track(MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local mousePos = UserInputService:GetMouseLocation()
        
        local function isInGui(gui)
            if not gui then return false end
            local absPos = gui.AbsolutePosition
            local absSize = gui.AbsoluteSize
            return mousePos.X >= absPos.X and mousePos.X <= absPos.X + absSize.X and
                   mousePos.Y >= absPos.Y and mousePos.Y <= absPos.Y + absSize.Y
        end
        
        if not isInGui(NameContainer) and not isInGui(StatusContainer) and not isInGui(AutoRejoinContainer) then
            dragging = true
            dragStart = input.Position
            startPos = MainFrame.Position
        end
    end
end))

track(UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        
        if ToastContainer.Visible then
            ToastContainer.Position = UDim2.new(MainFrame.Position.X.Scale, MainFrame.Position.X.Offset, MainFrame.Position.Y.Scale, MainFrame.Position.Y.Offset + 42)
        end
    end
end))

track(UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end))

local lastUpdate, frameCount = tick(), 0
track(RunService.RenderStepped:Connect(function()
    frameCount += 1
    local now = tick()
    if now - lastUpdate >= 1 then
        FpsLabel.Text = '<font color="rgb(110,130,160)">FPS</font> <font color="rgb(235,245,255)">' .. math.floor(frameCount / (now - lastUpdate)) .. '</font>'
        frameCount, lastUpdate = 0, now
    end
    
    local wave = (os.clock() % 2) / 2
    local offsetVal = Vector2.new(wave * 2 - 1, 0)
    
    for _, grad in ipairs(activeWaveGradients) do
        grad.Offset = offsetVal
    end
end))

