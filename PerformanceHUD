local activeToastTween = nil
local toastId = 0

local function showToast(message, color)
    toastId += 1
    local currentToastId = toastId
    
    ToastLabel.Text = message
    ToastLabel.TextColor3 = color or COLOR_TEXT
    
    local hiddenPos = UDim2.new(MainFrame.Position.X.Scale, MainFrame.Position.X.Offset, MainFrame.Position.Y.Scale, MainFrame.Position.Y.Offset)
    local targetPos = UDim2.new(MainFrame.Position.X.Scale, MainFrame.Position.X.Offset, MainFrame.Position.Y.Scale, MainFrame.Position.Y.Offset + 42)
    
    ToastContainer.Position = hiddenPos
    ToastContainer.Size = UDim2.new(0, 220, 0, 26)
    ToastContainer.Visible = true
    
    if activeToastTween then activeToastTween:Cancel() end
    
    activeToastTween = TweenService:Create(ToastContainer, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = targetPos,
        Size = UDim2.new(0, 260, 0, 26),
        BackgroundTransparency = 0.25
    })
    
    local fadeInLabel = TweenService:Create(ToastLabel, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        TextTransparency = 0
    })
    
    activeToastTween:Play()
    fadeInLabel:Play()
    
    task.delay(1.8, function()
        if currentToastId == toastId then
            activeToastTween = TweenService:Create(ToastContainer, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
                Position = hiddenPos,
                Size = UDim2.new(0, 220, 0, 26),
                BackgroundTransparency = 1
            })
            
            local fadeOutLabel = TweenService:Create(ToastLabel, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                TextTransparency = 1
            })
            
            activeToastTween:Play()
            fadeOutLabel:Play()
            
            activeToastTween.Completed:Connect(function()
                if ToastContainer.BackgroundTransparency >= 0.95 and currentToastId == toastId then
                    ToastContainer.Visible = false
                end
            end)
        end
    end)
end

local function createSection(name, width, text, showSep)
    local container = Instance.new("Frame", MainFrame)
    container.Name = name
    container.Size = UDim2.new(0, width, 1, 0)
    container.BackgroundTransparency = 1
    container.ZIndex = 2
    
    local label = Instance.new("TextLabel", container)
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    applyFont(label)
    label.Text = text
    label.TextColor3 = COLOR_TEXT
    label.TextSize = 14
    label.TextXAlignment = Enum.TextXAlignment.Center
    label.ZIndex = 2
    
    if showSep ~= false then
        local sep = Instance.new("Frame", container)
        sep.Size = UDim2.new(0, 1, 0, 16)
        sep.Position = UDim2.new(1, 0, 0.5, -8)
        sep.BackgroundColor3 = COLOR_MUTED
        sep.BackgroundTransparency = 0.4
        sep.BorderSizePixel = 0
        sep.ZIndex = 2
    end
    
    return label, container
end

local function createButtonSection(name, width, text, showSep)
    local container = Instance.new("TextButton", MainFrame)
    container.Name = name
    container.Size = UDim2.new(0, width, 1, 0)
    container.BackgroundTransparency = 1
    container.AutoButtonColor = false
    container.Text = ""
    container.ZIndex = 2
    
    local label = Instance.new("TextLabel", container)
    label.Size = UDim2.new(1, -10, 1, 0)
    label.Position = UDim2.new(0, 5, 0, 0)
    label.BackgroundTransparency = 1
    applyFont(label)
    label.Text = text
    label.TextColor3 = COLOR_TEXT
    label.TextSize = 14
    label.TextXAlignment = Enum.TextXAlignment.Center
    label.TextTruncate = Enum.TextTruncate.AtEnd
    label.ZIndex = 2
    
    if showSep ~= false then
        local sep = Instance.new("Frame", container)
        sep.Size = UDim2.new(0, 1, 0, 16)
        sep.Position = UDim2.new(1, -5, 0.5, -8)
        sep.BackgroundColor3 = COLOR_MUTED
        sep.BackgroundTransparency = 0.4
        sep.BorderSizePixel = 0
        sep.ZIndex = 2
    end
    
    return label, container
end

